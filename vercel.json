{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "pathfinder-v2": false
    }
  },
  "functions": {
    "api/generate.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/ping.json"
    }
  ]
}
